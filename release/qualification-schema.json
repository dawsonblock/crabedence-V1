{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crabedence Release Qualification Manifest",
  "description": "Canonical machine-readable qualification record. All release admission decisions derive from this file.",
  "type": "object",
  "required": ["schema_version", "source", "toolchains", "environment", "gates", "gate_summary", "release_status", "artifact_promotable", "invariants"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "object",
      "required": ["commit", "tree", "branch", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean", "const": false }
      }
    },
    "toolchains": {
      "type": "object",
      "required": ["go", "node", "npm", "git"],
      "properties": {
        "go": { "type": "string" },
        "node": { "type": "string" },
        "npm": { "type": "string" },
        "git": { "type": "string" },
        "postgres_client": { "type": "string" },
        "worker_package_version": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "required": ["os", "os_version", "arch", "date"],
      "properties": {
        "os": { "type": "string" },
        "os_version": { "type": "string" },
        "arch": { "type": "string" },
        "date": { "type": "string" }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "exit", "log"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "UNKNOWN"] },
          "exit": { "type": "integer" },
          "log": { "type": "string" }
        }
      }
    },
    "gate_summary": {
      "type": "object",
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" }
      }
    },
    "release_status": {
      "type": "string",
      "enum": ["PASS", "FAILED"]
    },
    "artifact_promotable": {
      "type": "boolean"
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^CRAB-V1-\\d{3}$" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
