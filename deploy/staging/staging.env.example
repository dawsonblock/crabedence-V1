# /etc/crabedence/staging.env — staging-only configuration for the
# Crabedence execution service. Install mode 0600, root:crabedence.
# Every value here is staging-scoped: nothing in this file may be
# shared with production.

# PostgreSQL DSN for the dedicated staging database (postgres backend is
# selected because CRABBOX_* store vars come from the unit file).
CRABEDENCE_DATABASE_URL=postgres://crabedence_staging:CHANGE_ME@PG_HOST:5432/crabedence_staging?sslmode=require

# Provisioned staging Ed25519 signing key (PEM). With CRABBOX_MODE=production
# the service refuses to start if this is absent — the trust root is
# provisioned, never auto-generated.
CRABBOX_EVIDENCE_KEY=/etc/crabedence/evidence-signing.pem

# Additional trusted signer fingerprints (comma-separated SHA-256 hex).
# Only needed for key rotation.
# CRABBOX_EVIDENCE_TRUSTED_SIGNERS=

# GitHub adapter — staging-scoped token only. The adapter stays
# unavailable (fail-closed) until this is set; CRITICAL capabilities
# are gated the same way and must not be enabled before gate stage 7.
# CRABBOX_GITHUB_ENABLED=true
# CRABBOX_GITHUB_TOKEN=CHANGE_ME
# CRABBOX_GITHUB_API_URL=
